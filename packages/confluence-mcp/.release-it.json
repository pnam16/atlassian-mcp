{
  "git": {
    "commit": true,
    "commitMessage": "chore(conf-mcp): release v${version}",
    "push": true,
    "pushTags": true,
    "requireCleanWorkingDir": true,
    "tag": true,
    "tagMatch": "conf-v*",
    "tagName": "conf-v${version}"
  },
  "github": {
    "release": true,
    "releaseName": "conf-mcp v${version}"
  },
  "hooks": {
    "after:release": "echo \"Released v${version}\"",
    "before:init": ["pnpm -w run lint", "npm test", "npm run build"]
  },
  "npm": {
    "allowSameVersion": false,
    "publish": false
  }
}
